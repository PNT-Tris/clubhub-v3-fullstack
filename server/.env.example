PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clubhub
# Use a cryptographically random secret with at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:5173

# Seed account represents the founder / global website administrator.
SEED_ADMIN_NAME=ClubHub Platform Founder
SEED_ADMIN_EMAIL=admin@clubhub.local
SEED_ADMIN_PASSWORD=ChangeThisStrongPassword123!

# Google Identity Services: same Web Client ID as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Meta for Developers / Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twilio Verify: send and verify SMS OTP for phone login / linking
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
